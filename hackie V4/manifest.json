{
  "manifest_version": 3,
  "name": "Hackie",
  "version": "1.0",
  "description": "A Hackie-style mascot that nudges you to move after too much scrolling.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "clippy.gif",
        "fonts/inter-latin-800-normal.woff2",
        "sprites/*.png"
      ],
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"]
    }
  ]
}
